<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- 全プロジェクト共通の基準フォルダ(このファイルの場所) -->
  <PropertyGroup Label="UserMacros">
	  <RootDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</RootDir>
  </PropertyGroup>

	<!-- 出力先と中間ファイル(プロジェクトごとに分ける) -->
	<PropertyGroup>
		<OutDir>$(RootDir)Bin\$(Platform)\$(Configuration)\</OutDir>
		<IntDir>$(RootDir)Intermediate\$(Platform)\$(Configuration)\$(ProjectName)\</IntDir>
		<!-- デバッグ実行時の作業ディレクトリ(Data/... を読めるように) -->
		<LocalDebuggerWorkingDirectory>$(RootDir)</LocalDebuggerWorkingDirectory>
	</PropertyGroup>
	
  <!-- 全構成共通 -->
  <ItemDefinitionGroup>
    <ClCompile>
            <AdditionalIncludeDirectories>$(RootDir)Source\Code;$(RootDir)External\imgui-docking;$(RootDir)External\imgui-docking\backends;$(RootDir)External\entt-main\single_include\entt;$(RootDir)External\GLTF;$(RootDir)External\tracy-0.13.1\public;$(RootDir)External\json-3.12.0\single_include\nlohmann;$(RootDir)External\DualSense-Windows-main\VS19_Solution\DualSenseWindows\include;$(RootDir)External\imgui-node-editor-master;$(RootDir)External\imgui-node-editor-master\external;$(RootDir)External\DirectXTK-main\Inc;$(RootDir)External\DirectXTex-may2026\DirectXTex;$(RootDir)External\cereal-master\include;$(RootDir)External\PhysX\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>_WINDOWS;TRACY_ENABLE;DS5W_USE_LIB;PX_PHYSX_STATIC_LIB;%(PreprocessorDefinitions)</PreprocessorDefinitions>
		<LanguageStandard>stdcpp20</LanguageStandard>
		<AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
		<ConformanceMode>false</ConformanceMode>
		<MultiProcessorCompilation>true</MultiProcessorCompilation>
		<SDLCheck>true</SDLCheck>
      <WarningLevel>Level3</WarningLevel>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>d3d11.lib;dxgi.lib;user32.lib;gdi32.lib;DirectXTK.lib;DirectXTex.lib;ds5w_x64.lib;hid.lib;setupapi.lib;PhysX_static_64.lib;PhysXCharacterKinematic_static_64.lib;PhysXCommon_static_64.lib;PhysXCooking_static_64.lib;PhysXExtensions_static_64.lib;PhysXFoundation_static_64.lib;PhysXPvdSDK_static_64.lib;PVDRuntime_64.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
	  <FxCompile>
		  <ShaderModel>5.0</ShaderModel>
		  <ObjectFileOutput>$(RootDir)Data\Shader\%(Filename).cso</ObjectFileOutput>
	  </FxCompile>
	  <!-- ビルド前に include の層ルールを検査する -->
	  <PreBuildEvent>
		  <Command>powershell -NoProfile -ExecutionPolicy Bypass -File "$(RootDir)Projects\Scripts\CheckIncludes.ps1" -Root "$(RootDir)." -Project "$(ProjectName)"</Command>
		  <Message>include の層ルールを検査しています</Message>
	  </PreBuildEvent>
  </ItemDefinitionGroup>
	
  <!-- Debug -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
      <Optimization>Disabled</Optimization>
      <BasicRuntimeChecks>EnableFastChecks</BasicRuntimeChecks>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(RootDir)External\DirectXTK-main\Bin\Desktop_2022_Win10\x64\Debug;$(RootDir)External\DirectXTex-may2026\DirectXTex\Bin\Desktop_2022_Win10\x64\Debug;$(RootDir)External\DualSense-Windows-main\VS19_Solution\bin\DualSenseWindows\Debug-x64;$(RootDir)External\PhysX\bin\win.x86_64.vc143.mt\debug;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>

  <!-- Release -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <AdditionalLibraryDirectories>$(RootDir)External\DirectXTK-main\Bin\Desktop_2022_Win10\x64\Release;$(RootDir)External\DirectXTex-may2026\DirectXTex\Bin\Desktop_2022_Win10\x64\Release;$(RootDir)External\DualSense-Windows-main\VS19_Solution\bin\DualSenseWindows\Release-x64;$(RootDir)External\PhysX\bin\win.x86_64.vc143.mt\release;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>

</Project>